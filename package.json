{
  "name": "ccusage-cursor-extension",
  "displayName": "CCUsage - Claude Code Usage Monitor",
  "description": "Display Claude Code usage statistics in the status bar using ccusage",
  "version": "0.0.1",
  "publisher": "evaneos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Evaneos/ccusage-cursor-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ccusage.refresh",
        "title": "CCUsage: Refresh Usage Stats"
      },
      {
        "command": "ccusage.showDaily",
        "title": "CCUsage: Show Daily Usage"
      },
      {
        "command": "ccusage.showMonthly",
        "title": "CCUsage: Show Monthly Usage"
      },
      {
        "command": "ccusage.showBlocks",
        "title": "CCUsage: Show 5-Hour Blocks Usage"
      }
    ],
    "configuration": {
      "title": "CCUsage",
      "properties": {
        "ccusage.refreshInterval": {
          "type": "number",
          "default": 300,
          "description": "Refresh interval in seconds (default: 300 = 5 minutes)"
        },
        "ccusage.showCost": {
          "type": "boolean",
          "default": true,
          "description": "Show cost in the status bar"
        },
        "ccusage.showTokens": {
          "type": "boolean",
          "default": true,
          "description": "Show token count in the status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
